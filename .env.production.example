# ACN Production Environment Configuration
# ==========================================
# Copy this file to .env on your production server and fill in ALL values.
# Fields marked [REQUIRED] must be set — the service will refuse to start without them.
# Fields marked [RECOMMENDED] are strongly advised for security.
# Never commit the actual .env file to version control.

# ─────────────────────────────────────────────
# Service
# ─────────────────────────────────────────────
SERVICE_NAME=ACN
SERVICE_VERSION=0.4.1
HOST=0.0.0.0
PORT=8000

# [REQUIRED] Must be false in production
DEV_MODE=false
ENABLE_DOCS=false         # set true on staging if needed

# ─────────────────────────────────────────────
# Redis  [REQUIRED]
# Used for: task state, pub/sub messaging, AND distributed rate limiting
# Without Redis, rate limiting falls back to in-memory (ineffective in multi-instance)
# ─────────────────────────────────────────────
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD   # [REQUIRED] strong random password

# ─────────────────────────────────────────────
# Backend & Gateway  [REQUIRED]
# ─────────────────────────────────────────────
# BACKEND_URL — the AgentPlanet Backend (escrow, rewards, wallet) that ACN
# calls service-to-service with X-Internal-Token. NOT the public ACN URL.
BACKEND_URL=https://api.yourdomain.com

# GATEWAY_BASE_URL — the public ACN URL embedded in every agent-card.json
# `url` field, every `referral_url`, every `agent_card_url`, etc. Whatever
# you set here is what the outside world will call ACN at.
#
# CRITICAL: do NOT set this to the PaaS-issued temporary hostname
# (e.g. *.up.railway.app, *.fly.dev, *.vercel.app). Those domains rotate
# when you migrate hosting providers, which kills every previously-served
# agent card. Always point GATEWAY_BASE_URL at your stable custom domain
# and put a permanent redirect on the PaaS hostname so direct hits there
# still funnel through the canonical host.
GATEWAY_BASE_URL=https://acn.yourdomain.com

# FRONTEND_BASE_URL — host of the Next.js Labs app that serves the
# `/claim/[id]` route (agentplanet/frontend). The `acn join` response's
# `claim_url` is built as `<FRONTEND_BASE_URL>/claim/<agent_id>?token=...`.
#
# CRITICAL: this is NOT the marketing site (https://acnlabs.dev is an
# Astro static site with no /claim route — pointing FRONTEND_BASE_URL at
# it yields a 404 for every human onboarding attempt) and it is NOT the
# API host (pointing here at GATEWAY_BASE_URL by mistake also 404s,
# because FastAPI doesn't serve the React route). Use the actual labs
# deployment host. Leave UNSET to fall back to GATEWAY_BASE_URL, which is
# only correct in single-host dev rigs where the API also serves the
# claim page.
FRONTEND_BASE_URL=https://labs.yourdomain.com

# ─────────────────────────────────────────────
# Escrow & Monetization
# ─────────────────────────────────────────────
# Set to false for self-hosted deployments not connected to Agent Planet Backend.
# When false, tasks work normally but payment settlement is skipped entirely.
ESCROW_ENABLED=true

# ACN revenue wallet ID in Backend (wallet_type=PLATFORM, label=acn_revenue).
# Create it with: python backend/scripts/seed_revenue_wallets.py
# Leave blank to run in zero-fee mode (ACN share returned to agent).
ACN_REVENUE_WALLET_ID=

# ─────────────────────────────────────────────
# Service-to-service authentication  [REQUIRED]
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────
INTERNAL_API_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN

# ─────────────────────────────────────────────
# Auth0  [REQUIRED in production]
# ─────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.agentplanet.com

# ─────────────────────────────────────────────
# Webhooks  [RECOMMENDED]
# ─────────────────────────────────────────────
WEBHOOK_URL=https://api.yourdomain.com/api/acn/webhook
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY=5

BILLING_WEBHOOK_URL=https://api.yourdomain.com/api/billing/webhook

# ─────────────────────────────────────────────
# CORS  [REQUIRED] — restrict to your actual origins
# ─────────────────────────────────────────────
CORS_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_ENABLED=false

# ─────────────────────────────────────────────
# Labs features
# ─────────────────────────────────────────────
LABS_ONBOARDING_ENABLED=true

# ─────────────────────────────────────────────
# Grafana (used by docker-compose monitoring profile)
# ─────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
