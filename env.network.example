# One native ACN. Copy to .env.network and fill the blanks.
# Do not point this file at the global or CN data stores.
# Compose forces this stack's own Redis and leaves DATABASE_URL empty.

# Host port. Inside the container the process listens on 8000.
# A second network on the same machine needs a different port.
ACN_NETWORK_PORT=9100

SERVICE_NAME=ACN
ENABLE_DOCS=false

# Each must be at least 32 characters, and they must differ.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
BLOB_SIGNING_SECRET=

# Human login. Required while DEV_MODE is false.
# A region may set HUMAN_OIDC_PROVIDERS_JSON instead of these two.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Callers use this URL. Local health is http://127.0.0.1:9100/health.
# The directory accepts only a public https URL, so change this before
# registering. Keep the host port and this URL on the same door.
GATEWAY_BASE_URL=http://127.0.0.1:9100
BACKEND_URL=http://127.0.0.1:9100
CORS_ORIGINS=["http://127.0.0.1:9100"]

LOG_LEVEL=INFO
OTEL_ENABLED=false
